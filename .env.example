# ========================================================
# Personal Expense Tracker - Environment Configuration
# ========================================================

# Django Security
SECRET_KEY=django-insecure-expense-tracker-mongo-cse494-secret-key-2026-prod
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ========================================================
# MongoDB Connection (MongoDB Atlas)
# ========================================================
# All expense tracking domain data AND user authentication/sessions
# are stored directly in MongoDB Atlas. No SQL database needed!
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=expense_tracker_db
