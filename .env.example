# ========================================================
# Personal Expense Tracker - Environment Configuration
# ========================================================

# Django Security
SECRET_KEY=django-insecure-expense-tracker-mongo-cse494-secret-key-2026-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================================
# MongoDB Connection
# ========================================================
# For MongoDB Atlas (Recommended):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority&appName=ExpenseTracker
#
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/
#
# If neither is available, the app includes an automatic in-memory mock fallback for offline evaluation/testing.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=expense_tracker_db
